# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr
*.tsbuildinfo
.vite

# Test coverage
coverage

# Local env files (`*.local` matches `.env.local`, `.env.*.local`, etc.)
*.local

# Rayfin — auto-generated or secret-bearing files
# `rayfin/.env*` covers .env, .env.bak (emitted by env-file v2 migration with
# secrets), and any future .env-family files Rayfin's runtime adds.
rayfin/.env*
# Trailing `*` also covers the .bak-* copies taken before re-pointing the CLI at a
# different workspace — those carry another demo's item IDs and must never be committed.
rayfin/.deployments.json*
rayfin/.temp/

